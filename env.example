AGENT_ASSISTANT_HOST=127.0.0.1
AGENT_ASSISTANT_PORT=7438

# Select one provider: deepseek | openai | anthropic | custom
AGENT_ASSISTANT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Confirm the chosen model is available on your own account.
AGENT_ASSISTANT_MAX_OUTPUT_TOKENS=4096
AGENT_ASSISTANT_THINKING=default

# Native providers use their own default endpoint and key:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Custom/compatibility gateway example (select provider=custom):
# AGENT_ASSISTANT_API_KEY=
# AGENT_ASSISTANT_LLM_BASE_URL=https://api.deepseek.com/anthropic
# AGENT_ASSISTANT_API_MODE=anthropic
# AGENT_ASSISTANT_LLM_MODEL=deepseek-flash

# Optional: keep conversations and event logs outside the installation directory.
# AGENT_ASSISTANT_STATE_DIR=/absolute/path/to/private-agent-state
